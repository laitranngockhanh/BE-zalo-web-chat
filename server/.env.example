# ===== Lưu trữ file đính kèm (blobStore) =====
# Nơi GHI file MỚI: "local" (đĩa server) hoặc "s3" (object storage tương thích S3).
# File CŨ vẫn đọc theo backend đã lưu trong DB, nên đổi giá trị này KHÔNG làm mất file cũ.
BLOB_STORAGE_BACKEND=local
# Thư mục lưu byte khi backend=local (mặc định server/storage/blobs nếu bỏ trống).
# BLOB_STORAGE_DIR=

# ----- Cấu hình S3 (chỉ cần khi BLOB_STORAGE_BACKEND=s3) -----
# Mặc định là Tebi. MinIO local: S3_ENDPOINT=http://localhost:9000. Backblaze B2/R2: endpoint tương ứng.
S3_ENDPOINT=https://s3.tebi.io
S3_REGION=global
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Tebi & MinIO dùng path-style. Đặt false nếu nhà cung cấp yêu cầu virtual-hosted-style.
S3_FORCE_PATH_STYLE=true

# ===== Auth API key (bước 1 — trước khi có JWT từ ERP) =====
# 2 cấp: AGENT (FE inbox), ADMIN (vận hành: QR/logout/đổi tài khoản). Client gửi header X-Api-Key;
# Socket.IO gửi auth.token. ĐỂ TRỐNG CẢ HAI = tắt auth (chỉ nên khi dev một mình, server sẽ cảnh báo).
# Sinh key: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_API_KEY=
ADMIN_API_KEY=

# CORS whitelist — origin (phân tách dấu phẩy) được phép gọi API + Socket.IO từ TRÌNH DUYỆT.
# ĐỂ TRỐNG = mở mọi origin (chỉ nên khi dev một mình, server sẽ cảnh báo).
# Vd: ALLOWED_ORIGINS=http://localhost:5173,https://erp.nafoods.com
ALLOWED_ORIGINS=

# Trần số lời gọi AI mỗi phút (đếm CHUNG cả server — bảo vệ quota AI dùng chung). Mặc định 20.
# AI_RATE_LIMIT_PER_MIN=20

# Trần kích thước MỖI file server tải từ CDN Zalo (media proxy + AI + forward). Mặc định 25MB.
# MEDIA_PROXY_MAX_MB=25

# ===== RabbitMQ (publish event realtime cho hệ thống ngoài) =====
# App CHỈ nối cổng AMQP (5672) qua URL này — KHÔNG cần management port (15672, chỉ là web UI cho người xem).
# ĐỂ TRỐNG = tắt publish (chưa cắm broker, server vẫn chạy bình thường).
# ⚠ user `guest` CHỈ kết nối được từ localhost; broker ở HOST KHÁC phải dùng user thật (guest sẽ bị ACCESS_REFUSED).
# ⚠ vhost mặc định "/" = KHÔNG có dấu "/" cuối URL (thêm "/" cuối = vhost rỗng, khác vhost "/").
#   Local test:  amqp://guest:guest@localhost:5672
#   Host khác:   amqp://<user>:<pass>@<host>:5672            (thêm /<vhost> ở cuối nếu không phải vhost mặc định)
RABBITMQ_URL=
# ĐA KÊNH: MỘT exchange dùng chung cho MỌI kênh, phân kênh bằng ROUTING KEY `<platform>.*`
#   sự kiện (gateway publish): zalo.message.new, facebook.message.new, …
#   lệnh gửi (hệ thống ngoài publish): zalo.command.send, facebook.command.send, …
# Gateway vẫn dựng QUEUE RIÊNG mỗi kênh (`<platform>.gateway.commands`) nên kênh này nghẽn không chặn kênh kia.
# Giữ tên mặc định `zalo.*` để hệ thống ngoài ĐANG CHẠY không phải đổi gì; muốn tên trung lập
# (chat.events/chat.commands) thì đổi ở đây và hai bên đổi CÙNG LÚC.
RABBITMQ_EXCHANGE=zalo.events
RABBITMQ_COMMAND_EXCHANGE=zalo.commands

# ===== Facebook Fanpage (Messenger) =====
# ĐỂ TRỐNG FB_PAGE_TOKEN hoặc FB_APP_SECRET = TẮT HẲN kênh Facebook (server chạy y nguyên với mình Zalo).
# Khác Zalo: KHÔNG đăng nhập QR (dùng Page token), và Meta ĐẨY webhook VÀO server
# => gateway BẮT BUỘC có URL HTTPS công khai (dev: cloudflared/ngrok; prod: domain + TLS thật).
#
# ⚠ BẪY HAY GẶP (xem facebook-messenger-integration.md mục 0-B):
#   • FB_APP_SECRET là 32 KÝ TỰ HEX — KHÔNG phải App ID (~16 chữ số). Nhầm => mọi webhook 403.
#   • FB_PAGE_TOKEN phải là PAGE token, KHÔNG phải User token. Kiểm: GET /me phải trả đúng FB_PAGE_ID.
#   • Quyền tối thiểu: pages_messaging, pages_manage_metadata, pages_show_list, pages_read_engagement.
#     Xin THỪA quyền sẽ làm TRƯỢT App Review (Meta bắt quay video chứng minh từng quyền).
#   • Phải đăng ký webhook ở CẢ HAI tầng: POST /{app-id}/subscriptions (fields) VÀ /{page-id}/subscribed_apps.
#     Thiếu tầng App thì verify vẫn "thành công" nhưng KHÔNG event nào về — không báo lỗi gì cả.
FB_PAGE_TOKEN=
FB_PAGE_ID=
FB_APP_SECRET=
# Chuỗi ngẫu nhiên do MÌNH tự đặt (Meta không cấp) — điền GIỐNG HỆT vào ô "Verify Token" trên Meta.
FB_VERIFY_TOKEN=
FB_GRAPH_VERSION=v21.0
