# ===== Lưu trữ file đính kèm (blobStore) =====
# Nơi GHI file MỚI: "local" (đĩa server) hoặc "s3" (object storage tương thích S3).
# File CŨ vẫn đọc theo backend đã lưu trong DB, nên đổi giá trị này KHÔNG làm mất file cũ.
BLOB_STORAGE_BACKEND=local
# Thư mục lưu byte khi backend=local (mặc định server/storage/blobs nếu bỏ trống).
# BLOB_STORAGE_DIR=

# ----- Cấu hình S3 (chỉ cần khi BLOB_STORAGE_BACKEND=s3) -----
# Mặc định là Tebi. MinIO local: S3_ENDPOINT=http://localhost:9000. Backblaze B2/R2: endpoint tương ứng.
S3_ENDPOINT=https://s3.tebi.io
S3_REGION=global
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Tebi & MinIO dùng path-style. Đặt false nếu nhà cung cấp yêu cầu virtual-hosted-style.
S3_FORCE_PATH_STYLE=true

# ===== Auth API key (bước 1 — trước khi có JWT từ ERP) =====
# 2 cấp: AGENT (FE inbox), ADMIN (vận hành: QR/logout/đổi tài khoản). Client gửi header X-Api-Key;
# Socket.IO gửi auth.token. ĐỂ TRỐNG CẢ HAI = tắt auth (chỉ nên khi dev một mình, server sẽ cảnh báo).
# Sinh key: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_API_KEY=
ADMIN_API_KEY=

# CORS whitelist — origin (phân tách dấu phẩy) được phép gọi API + Socket.IO từ TRÌNH DUYỆT.
# ĐỂ TRỐNG = mở mọi origin (chỉ nên khi dev một mình, server sẽ cảnh báo).
# Vd: ALLOWED_ORIGINS=http://localhost:5173,https://erp.nafoods.com
ALLOWED_ORIGINS=

# Trần số lời gọi AI mỗi phút (đếm CHUNG cả server — bảo vệ quota AI dùng chung). Mặc định 20.
# AI_RATE_LIMIT_PER_MIN=20

# Trần kích thước MỖI file server tải từ CDN Zalo (media proxy + AI + forward). Mặc định 25MB.
# MEDIA_PROXY_MAX_MB=25
